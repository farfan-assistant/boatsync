# BoatSync Configuration

# Server
PORT=3000
HOST=0.0.0.0

# Sync interval in minutes (how often to poll iCal feeds)
SYNC_INTERVAL_MINUTES=15

# Data directory (SQLite database location)
DATA_DIR=./data

# Optional: Base URL for generating feed URLs (auto-detected if not set)
# BASE_URL=https://your-domain.com
